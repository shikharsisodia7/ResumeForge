generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An application user, mirrored from an Auth0 identity on first sign-in.
model User {
  id          String   @id @default(cuid())
  auth0Sub    String   @unique
  email       String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resumes        Resume[]
  customPrompts  CustomPrompt[]
  generationRuns GenerationRun[]

  @@index([email])
}

/// An originally-uploaded resume file, owned by one user.
model Resume {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String
  mimeType         String
  storageKey       String   @unique
  sourceText       String   @db.Text
  fileHash         String
  isProcessing     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions       ResumeVersion[]
  generationRuns GenerationRun[]

  @@index([userId])
  @@index([userId, fileHash])
}

/// One formatted/tailored rendition of a resume. Content and style are
/// stored separately so factual data never mixes with presentation choices.
model ResumeVersion {
  id             String  @id @default(cuid())
  resumeId       String
  resume         Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name           String
  targetCompany  String?
  targetRole     String?
  jobDescription String? @db.Text

  parentVersionId String?
  parentVersion   ResumeVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   ResumeVersion[] @relation("VersionLineage")

  // Current, user-visible state.
  contentJson Json
  styleJson   Json
  revision    Int  @default(1)

  // Immutable snapshot from the initial AI formatting pass — restored on reset.
  baseContentJson Json
  baseStyleJson   Json

  // Snapshot taken immediately before the most recent successful mutation —
  // enables a single-step undo without a full revision-history table.
  previousContentJson Json?
  previousStyleJson   Json?
  previousRevision    Int?

  isProcessing Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versionPrompts VersionPrompt[]
  generationRuns GenerationRun[]

  @@index([resumeId])
}

/// A reusable natural-language formatting instruction saved by its creator.
model CustomPrompt {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  text        String   @db.Text
  description String?  @db.Text
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  copiedFromId String?
  copiedFrom   CustomPrompt?  @relation("PromptCopyLineage", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       CustomPrompt[] @relation("PromptCopyLineage")

  versionPrompts VersionPrompt[]

  @@unique([creatorId, copiedFromId])
  @@index([creatorId])
  @@index([isShared, createdAt])
}

/// Join model: which prompts are applied to which version, in what order.
model VersionPrompt {
  id        String        @id @default(cuid())
  versionId String
  version   ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  promptId  String
  prompt    CustomPrompt  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  order     Int
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([versionId, promptId])
  @@index([versionId, order])
}

enum GenerationOperation {
  FORMAT
  CUSTOMIZE
  TAILOR
  RESET
  UNDO
}

enum GenerationStatus {
  PENDING
  SUCCESS
  FAILURE
}

/// Audit trail of every AI (and reset/undo) operation performed on a resume.
model GenerationRun {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    Resume              @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionId String?
  version   ResumeVersion?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  operation GenerationOperation
  modelId   String
  status    GenerationStatus    @default(PENDING)

  promptHash       String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  errorMessage     String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([versionId])
}
