    "@langchain/openai": "^1.5.5",
    "@napi-rs/canvas": "^1.0.3",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.0",
