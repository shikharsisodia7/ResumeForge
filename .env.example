# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
# Local: postgresql://user:password@localhost:5432/resumeforge
# Vercel: use a Vercel Postgres / Neon connection string from `vercel env pull`
DATABASE_URL=

# --- Auth0 (@auth0/nextjs-auth0 v4) ---
# Tenant domain, e.g. "your-tenant.us.auth0.com" (no https://, no trailing slash)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret used to encrypt the session cookie: `openssl rand -hex 32`
AUTH0_SECRET=
# Your app's canonical URL, e.g. http://localhost:3000 or https://your-app.vercel.app
APP_BASE_URL=

# --- OpenAI / LangChain ---
OPENAI_API_KEY=
# Model used for resume extraction and customization
OPENAI_MODEL=gpt-4.1

# --- Vercel Blob (private object storage for resumes + generated PDFs) ---
BLOB_READ_WRITE_TOKEN=
